{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "empresaId",
    "empresaNome",
    "tipoCompensacao",
    "descricao",
    "quantidadeCompensada",
    "dataAcao"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "empresaId": {
      "type": "integer"
    },
    "empresaNome": {
      "type": "string",
      "minLength": 1
    },
    "tipoCompensacao": {
      "type": "string",
      "minLength": 1
    },
    "descricao": {
      "type": "string",
      "minLength": 1
    },
    "quantidadeCompensada": {
      "type": "number"
    },
    "dataAcao": {
      "type": "string",
      "minLength": 8
    }
  }
}
