{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "content",
    "totalElements",
    "totalPages",
    "size",
    "number"
  ],
  "properties": {
    "content": {
      "type": "array",
      "minItems": 1
    },
    "totalElements": {
      "type": "integer",
      "minimum": 1
    },
    "totalPages": {
      "type": "integer",
      "minimum": 1
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "number": {
      "type": "integer",
      "minimum": 0
    }
  }
}
