{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "empresaId",
    "empresaNome",
    "quantidadeCo2",
    "fonteEmissao",
    "dataRegistro",
    "unidadeMedida"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "empresaId": {
      "type": "integer"
    },
    "empresaNome": {
      "type": "string",
      "minLength": 1
    },
    "quantidadeCo2": {
      "type": "number"
    },
    "fonteEmissao": {
      "type": "string",
      "minLength": 1
    },
    "dataRegistro": {
      "type": "string",
      "minLength": 8
    },
    "unidadeMedida": {
      "type": "string",
      "minLength": 1
    }
  }
}
