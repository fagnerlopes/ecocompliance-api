{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "empresaId",
    "empresaNome",
    "dataAuditoria",
    "resultado",
    "observacoes",
    "nivelRisco"
  ],
  "properties": {
    "id": {
      "type": "integer"
    },
    "empresaId": {
      "type": "integer"
    },
    "empresaNome": {
      "type": "string",
      "minLength": 1
    },
    "dataAuditoria": {
      "type": "string",
      "minLength": 8
    },
    "resultado": {
      "type": "string",
      "minLength": 1
    },
    "observacoes": {
      "type": "string",
      "minLength": 1
    },
    "nivelRisco": {
      "type": "string",
      "enum": [
        "BAIXO",
        "MEDIO",
        "ALTO"
      ]
    }
  }
}
