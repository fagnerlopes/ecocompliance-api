{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "timestamp",
    "status",
    "error",
    "message",
    "path"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "minLength": 8
    },
    "status": {
      "type": "integer"
    },
    "error": {
      "type": "string",
      "minLength": 1
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "fieldErrors": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "campo",
          "mensagem"
        ],
        "properties": {
          "campo": {
            "type": "string",
            "minLength": 1
          },
          "mensagem": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
