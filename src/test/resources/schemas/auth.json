{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token",
    "tipo",
    "email",
    "nome",
    "role"
  ],
  "properties": {
    "token": {
      "type": "string",
      "minLength": 1
    },
    "tipo": {
      "type": "string",
      "enum": [
        "Bearer"
      ]
    },
    "email": {
      "type": "string",
      "minLength": 1
    },
    "nome": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "type": "string",
      "enum": [
        "ADMIN",
        "USER"
      ]
    }
  }
}
